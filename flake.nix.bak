{
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};

      # 1. Let Nixpkgs natively parse and fetch everything in the lockfile
      npmDeps = pkgs.importNpmLock {
        npmRoot = ./.; # Assumes package.json and package-lock.json are in the root
      };

    in
    {
      # 2. Extract/copy the raw .tgz files out of the npm cache output into a clean folder
      packages.${system}.default = pkgs.runCommand "extract-npm-tarballs" { } ''
        mkdir -p $out/tarballs
        # Find all .tgz files generated in the npmDeps store path and copy them over
        find ${npmDeps} -name "*.tgz" -exec cp {} $out/tarballs/ \;
      '';
    };
}
